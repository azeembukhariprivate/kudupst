<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KUDUPST</AssemblyName>
    <RootNamespace>Kudupst</RootNamespace>
    <ApplicationIcon>Assets\KUDUPST.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <StartupObject>Kudupst.Program</StartupObject>

    <Version>1.0.0</Version>
    <Product>KUDUPST</Product>
    <Company>Azeem Bukhari</Company>
    <Authors>Azeem Bukhari</Authors>
    <Copyright>Copyright © 2026 Azeem Bukhari</Copyright>
    <Description>KUDUPST - view, search and export Outlook PST and OST files</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!--
    The screens are built in C# and the themes are XAML files loaded at startup, so the project
    needs no XAML compiler and builds with the plain .NET SDK on any operating system.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Shows emails as web pages with the Edge engine that comes with Windows, and prints them to PDF (BSD licence). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Joins several emails' PDFs into one file (MIT). -->
    <PackageReference Include="PDFsharp" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Themes\*.xaml" LogicalName="Kudupst.Themes.%(Filename).xaml" />
    <EmbeddedResource Include="Assets\KUDUPST.ico" LogicalName="Kudupst.Assets.KUDUPST.ico" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
